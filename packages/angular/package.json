{
  "name": "@flowink/angular",
  "version": "0.1.2",
  "description": "Angular standalone component rendering FlowInk animated flow diagrams.",
  "type": "module",
  "peerDependencies": {
    "@angular/core": ">=16",
    "@angular/platform-browser": ">=16",
    "@flowink/core": "0.1.2"
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.ngc.json",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "module": "./dist/fesm2022/flowink-angular.mjs",
  "types": "./dist/types/flowink-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/flowink-angular.d.ts",
      "default": "./dist/fesm2022/flowink-angular.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "logo.svg"
  ],
  "devDependencies": {
    "ng-packagr": "^21.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex5350/flowink.git"
  },
  "license": "MIT"
}
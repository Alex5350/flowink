{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@flowink/angular": ["../../packages/angular/src/index.ts"],
      "@flowink/core": ["../../packages/core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "../../packages/angular/src/**/*.ts", "../../packages/core/src/**/*.ts"]
}
